# =============================================================================
# Awesome AI DevKit — 环境变量模板
# =============================================================================
# 复制为 .env 并填写实际值（cp .env.example .env）
# 不要将 .env 提交到版本控制

# ── 模型配置（Agent 使用的 LLM） ──
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_API_KEY=

# ── 项目上下文 ──
PROJECT_ROOT=.

# ── 数据库（可选， postgres MCP server 需要） ──
DATABASE_URL=

# ── 通知（可选，错误告警用） ──
SLACK_WEBHOOK_URL=

# ── 开发环境 ──
NODE_ENV=development
DEBUG=false
